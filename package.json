    "test": "vitest run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@onirenaud/node-webgl": "^0.2.0",
    "@types/node": "^25.6.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "three": "^0.186.0",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.15",
    "typescript": "^7",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <0.200.0",
    "three-gpu-pathtracer": ">=0.0.24 <0.1.0",
    "three-mesh-bvh": ">=0.9.15 <0.10.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.0.8"
}
