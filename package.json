{
  "name": "fidelity-kit-three-gpu-pathtracer",
  "version": "0.1.0",
  "description": "Reusable fidelity-kit renderer for legacy Three.js WebGL GPU path tracing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/fidelity-kit-three-gpu-pathtracer.git"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
